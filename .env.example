# 安好 AI 自主生活守護 — 環境變數
# 複製為 .env。未填外部服務金鑰時，系統一律使用 Fake adapter，可完整啟動與測試。

NODE_ENV=development
PORT=3000

# ── 資料庫 ─────────────────────────────────────────────
DATABASE_URL=postgres://anhao:anhao@localhost:5432/anhao

# ── 佇列（Webhook 3 秒內回 200 的硬需求）────────────────
REDIS_URL=redis://localhost:6379

# ── 欄位級加密 ─────────────────────────────────────────
# development：local。message.text 與 gov_health_record.payload 以 AES-256-GCM 加密。
# production：kms（正式環境必須用雲端 KMS，見交接規格第 7 節）
CRYPTO_PROVIDER=local
# 32 bytes，base64。僅供本機開發，切勿用於正式環境。
# 自行產生：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CRYPTO_LOCAL_KEY=YW5oYW8tZGV2LW9ubHkta2V5LWRvLW5vdC11c2UhISE=
CRYPTO_KMS_KEY_ID=

# ── 外部服務（留空 = 使用 Fake adapter）──────────────────
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# 填了 LLM_API_KEY 就走真串接（OpenAI），留空則用規則式假實作。
LLM_API_KEY=
# 留空預設 gpt-4o。需支援 structured outputs（json_schema + strict）。
LLM_MODEL=
# 相容 OpenAI API 的自架或代理端點；留空走官方。
LLM_BASE_URL=

STT_PROVIDER=fake
OCR_PROVIDER=fake

# 健康存摺 MyHealthBank（健保署）OAuth 2.0 + FHIR R4
# TODO(business)：正式介接資格與申請流程待商務與法務確認
MYHEALTHBANK_CLIENT_ID=
MYHEALTHBANK_CLIENT_SECRET=
MYHEALTHBANK_BASE_URL=

# 成人預防保健資格（國健署）REST + API Key
HPA_API_KEY=
HPA_BASE_URL=

# 社區照顧關懷據點活動（社家署／地方衛生局）Open Data
# TODO(business)：各地方衛生局更新頻率差異待確認
COMMUNITY_ACTIVITY_DATASET_URL=

# ── 物件儲存（語音與照片）───────────────────────────────
OBJECT_STORAGE_PROVIDER=fake
OBJECT_STORAGE_BUCKET=
# TODO(business)：語音留存保存期限上限待法務確認，暫定 90 天
VOICE_RETENTION_DAYS=90

# ── 產品規則門檻（可調，不需改程式）────────────────────
# SPEC-CONFLICT：交接規格第 4 節為 21 個有效生活日；SRS F2-01 為 21 天且 12 個有效生活日。
# 預設採較嚴格的交接規格值。詳見 src/modules/baseline/baseline.config.ts
BASELINE_MIN_EFFECTIVE_DAYS=21
BASELINE_WINDOW_DAYS=28
STT_MIN_CONFIDENCE=0.75
SIGNAL_REVIEW_CONFIDENCE_THRESHOLD=0.70
QUIET_HOURS_START=22:00
QUIET_HOURS_END=07:30
